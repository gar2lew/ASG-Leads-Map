# Firebase Configuration (Client-side - safe to expose)
VITE_FIREBASE_API_KEY=your_api_key
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.appspot.com
VITE_FIREBASE_MESSAGING_SENDER_ID=your_sender_id
VITE_FIREBASE_APP_ID=your_app_id

# MapLibre (optional - for custom styles)
VITE_MAP_STYLE_URL=https://your-map-style-url

# Jotform (server-side only - DO NOT prefix with VITE_)
# JOTFORM_API_KEY=your_jotform_api_key
# JOTFORM_FORM_ID=your_form_id

# Feature flags
VITE_ENABLE_OFFLINE=true
VITE_ENABLE_PWA=true